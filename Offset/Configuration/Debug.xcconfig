#include "Shared.xcconfig"

// RevenueCat public SDK keys are safe to embed in an app, but keeping the key
// here avoids source literals and makes environment switching explicit.
REVENUECAT_API_KEY = test_fpfYszFlxcRaJIMHjFtJnLwnlPo
ONESIGNAL_APP_ID = REPLACE_WITH_ONESIGNAL_APP_ID

APS_ENVIRONMENT = development

// Free/Personal Teams cannot sign the APNs entitlement. This keeps Debug
// installable today; override it in Secrets.xcconfig once the paid team is live.
CODE_SIGN_ENTITLEMENTS = Offset/Offset.Personal.entitlements

// Local values take precedence over the checked-in development defaults.
#include? "Secrets.xcconfig"
